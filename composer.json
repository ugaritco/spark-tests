{
    "name": "ugarit/ugarit",
    "description": "The Ugarit Framework.",
    "keywords": [
        "framework",
        "ugarit"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=5.5.9",
        "ugarit/framework": "^1.00.00",
        "ugarit/spark": "^1.00.00",
        "ugarit/cashier": "^1.00.00",
        "doctrine/dbal": "^2.5",
        "league/flysystem-aws-s3-v3": "^1.0",
        "firebase/php-jwt": "^3.0",
        "mpociot/vat-calculator": "~1.0"
    },
    "require-dev": {
        "fzaninotto/faker": "~1.4",
        "mockery/mockery": "0.9.*",
        "phpunit/phpunit": "~4.0",
        "symfony/css-selector": "2.8.*|3.0.*",
        "symfony/dom-crawler": "2.8.*|3.0.*"
    },
    "autoload": {
        "classmap": [
            "database",
            "tests"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php scribe key:generate"
        ],
        "post-install-cmd": [
            "php scribe clear-compiled",
            "php scribe optimize"
        ],
        "pre-update-cmd": [
            "php scribe clear-compiled"
        ],
        "post-update-cmd": [
            "php scribe optimize"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "./../lib"
        }
    ],
    "minimum-stability": "dev",
    "config": {
        "preferred-install": "dist"
    },
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "version": "1.00.00"
}
